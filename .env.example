# Server
PORT=3000
NODE_ENV=development

# MongoDB (use either MONGO_URI or MONGODB_URI)
# Local (no auth): mongodb://127.0.0.1:27017/social_db
# Local (with auth): mongodb://USER:PASSWORD@127.0.0.1:27017/DB_NAME?authSource=DB_NAME
# EC2 example:    mongodb://social_user:YOUR_PASSWORD@127.0.0.1:27017/social_db?authSource=social_db
# If password has @ or #, use percent-encoding (e.g. @ → %40, # → %23)
MONGO_URI=mongodb://127.0.0.1:27017/social_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this

# Email (for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudflare R2 (images for posts & profiles)
# Get these from: Cloudflare Dashboard → Storage & databases → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=social-images
# Public URL for images (enable "Allow public access" on bucket, or use custom domain)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
